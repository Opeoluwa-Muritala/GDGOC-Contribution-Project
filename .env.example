# Fine-grained GitHub personal access token with access to GITHUB_REPO.
# Required repository permissions:
#   Contents: Read and write
#   Pull requests: Read and write
GITHUB_TOKEN=ghp_your_github_token_here

# Repository that should receive contributions, in owner/name format.
GITHUB_REPO=your-github-username/your-docs-repository

# Optional: allow requests from a separately hosted docs site.
# Leave empty when the form and API are served from the same origin.
ALLOWED_ORIGIN=

# Optional: branch that contributions are based on.
GITHUB_BASE_BRANCH=main

# Optional: set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# Go backend listen port.
PORT=8080
